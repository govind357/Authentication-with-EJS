<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <table border="1">
       <thead>
         <tr>
        <th>id </th>
        <th>name</th>
        <th>email</th>
        </tr>
       </thead>
    <% userdetails.forEach((user)=>{ %>

        <tr>
            <td>
